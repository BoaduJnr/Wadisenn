# Copy to `.env` and fill in. `.env` is gitignored, so secrets here are never
# committed. A real environment variable always wins over this file.

# Required. MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Use a Database Access user, which is NOT your Atlas account login.
MONGODB_URI=

# Optional. Database name inside the cluster. Defaults to any name in the URI
# path, else "wadisenn".
MONGODB_DB=wadisenn

# Optional. Port to listen on locally. Render injects its own.
PORT=8000

# Optional. Without it the Advice tab reports itself switched off and every
# other feature works normally. There is no fallback key in the source.
NVIDIA_API_KEY=

# Optional. Defaults to nvidia/nemotron-3.5-bolt-e4b.
NVIDIA_MODEL=
